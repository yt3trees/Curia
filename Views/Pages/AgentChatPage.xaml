<UserControl x:Class="Curia.Views.Pages.AgentChatPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="750" d:DesignWidth="1100"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid Margin="18,12,18,42">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Agent Chat" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AppText}"/>
                <TextBlock Text="Read-only project assistant" FontSize="11" Margin="12,6,0,0" Foreground="{DynamicResource AppSubtext0}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Tools" Command="{Binding ToggleToolsPanelCommand}" Padding="10,4" Appearance="Secondary" Margin="0,0,8,0"/>
                <ui:Button Content="New Session" Command="{Binding NewSessionCommand}" Padding="10,4" Appearance="Secondary"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Background="{DynamicResource AppSurface0}" BorderBrush="{DynamicResource AppSurface2}" BorderThickness="1" CornerRadius="6" Padding="12">
            <Grid>
                <ScrollViewer x:Name="MessageScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,7" Margin="0,0,0,8" CornerRadius="6" MaxWidth="780" HorizontalAlignment="Left" Background="{DynamicResource AppSurface1}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUser}" Value="True"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Background" Value="{DynamicResource AppBlue}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding IsToolActivity}" Value="True"><Setter Property="Background" Value="{DynamicResource AppSurface2}"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding Kind}" FontSize="10" Foreground="{DynamicResource AppSubtext0}" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding DisplayText}" IsReadOnly="True" IsTabStop="False"
                                             TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0" Padding="0"
                                             Background="Transparent" Foreground="{DynamicResource AppText}"
                                             CaretBrush="{DynamicResource AppText}"/>
                                    <Border Background="{DynamicResource AppSurface1}" CornerRadius="3" Padding="7,5" Margin="0,6,0,0"
                                            Visibility="{Binding IsToolCall, Converter={StaticResource BoolToVis}}">
                                        <TextBox Text="{Binding ToolArgumentsDisplay}" IsReadOnly="True" IsTabStop="False"
                                                 TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0" Padding="0"
                                                 Background="Transparent" Foreground="{DynamicResource AppSubtext0}"
                                                 CaretBrush="{DynamicResource AppText}" FontFamily="Consolas, Courier New" FontSize="11"/>
                                    </Border>
                                    <Border Background="{DynamicResource AppSurface1}" CornerRadius="3" Padding="7,5" Margin="0,6,0,0"
                                            Visibility="{Binding IsToolResult, Converter={StaticResource BoolToVis}}">
                                        <TextBox Text="{Binding ToolResultContent}" IsReadOnly="True" IsTabStop="False"
                                                 TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0" Padding="0"
                                                 Background="Transparent" Foreground="{DynamicResource AppSubtext0}"
                                                 CaretBrush="{DynamicResource AppText}" FontFamily="Consolas, Courier New" FontSize="11"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Text="Enable AI and run Test Agent Compatibility in Settings to begin." TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AppSubtext0}">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CanUseAgent}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <Border Width="360" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="2"
                        Background="{DynamicResource AppSurface0}" BorderBrush="{DynamicResource AppSurface2}" BorderThickness="1" CornerRadius="6"
                        Visibility="{Binding IsToolsPanelVisible, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="Available tools" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AppText}" Margin="12,12,12,8"/>
                        <ScrollViewer Grid.Row="1" MaxHeight="480" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Tools}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource AppSurface1}" CornerRadius="4" Padding="8" Margin="12,0,18,6">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource AppText}"/>
                                                <TextBlock Text="{Binding Description}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource AppSubtext0}" Margin="0,3,0,0"/>
                                                <TextBlock Text="{Binding ParametersSchema}" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource AppOverlay1}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{DynamicResource AppSubtext0}" Margin="0,0,0,4"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}" Padding="8,6" Background="{DynamicResource AppSurface1}" Foreground="{DynamicResource AppText}" BorderBrush="{DynamicResource AppSurface2}" KeyDown="OnInputKeyDown" ToolTip="Press Ctrl+Enter to send"/>
                <ui:Button Grid.Column="1" Content="Send" Command="{Binding SendCommand}" IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}" Margin="8,0,0,0" Padding="16,6"/>
                <ui:Button Grid.Column="2" Content="Stop" Command="{Binding CancelCommand}" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" Margin="8,0,0,0" Padding="16,6" Appearance="Secondary"/>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>