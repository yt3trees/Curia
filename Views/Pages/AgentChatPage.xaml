<UserControl x:Class="Curia.Views.Pages.AgentChatPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:markdig="clr-namespace:Markdig.Wpf;assembly=Markdig.Wpf"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="750" d:DesignWidth="1100"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="{x:Static markdig:Styles.CodeStyleKey}" TargetType="{x:Type Run}">
            <Setter Property="Foreground" Value="{DynamicResource AppText}"/>
            <Setter Property="Background" Value="{DynamicResource AppSurface2}"/>
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="{x:Static markdig:Styles.CodeBlockStyleKey}" TargetType="{x:Type Paragraph}">
            <Setter Property="Foreground" Value="{DynamicResource AppText}"/>
            <Setter Property="Background" Value="{DynamicResource AppSurface2}"/>
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="18,12,18,42">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Agent Chat" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AppText}"/>
                <TextBlock Text="Project assistant" FontSize="11" Margin="12,6,0,0" Foreground="{DynamicResource AppSubtext0}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Tools" Command="{Binding ToggleToolsPanelCommand}" Padding="10,4" Appearance="Secondary" Margin="0,0,8,0"/>
                <ui:Button Content="History" Command="{Binding ToggleHistoryPanelCommand}" Padding="10,4" Appearance="Secondary" Margin="0,0,8,0"/>
                <ui:Button Content="New Session" Command="{Binding NewSessionCommand}" Padding="10,4" Appearance="Secondary"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Background="{DynamicResource AppSurface0}" BorderBrush="{DynamicResource AppSurface2}" BorderThickness="1" CornerRadius="6" Padding="12">
            <Grid>
                <ScrollViewer x:Name="MessageScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="OnMessageScrollPreviewMouseWheel">
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,7" Margin="0,0,0,8" CornerRadius="6" MaxWidth="780" HorizontalAlignment="Left" Background="{DynamicResource AppSurface1}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUser}" Value="True"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Background" Value="{DynamicResource AppBlue}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding IsToolActivity}" Value="True"><Setter Property="Background" Value="{DynamicResource AppSurface2}"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding Kind}" FontSize="10" Foreground="{DynamicResource AppSubtext0}" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding DisplayText, Mode=OneWay}" IsReadOnly="True" IsTabStop="False"
                                             TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0" Padding="0"
                                             Background="Transparent" Foreground="{DynamicResource AppText}"
                                             CaretBrush="{DynamicResource AppText}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAssistant}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <markdig:MarkdownViewer Markdown="{Binding Text, NotifyOnTargetUpdated=True}" Foreground="{DynamicResource AppText}" Background="Transparent"
                                                            FontFamily="Segoe UI, Yu Gothic UI, Meiryo UI, Arial" FontSize="14"
                                                            Loaded="OnMarkdownViewerLoaded" DataContextChanged="OnMarkdownViewerDataContextChanged" TargetUpdated="OnMarkdownViewerTargetUpdated"
                                                            Visibility="{Binding IsAssistant, Converter={StaticResource BoolToVis}}"/>
                                    <Border Background="{DynamicResource AppSurface1}" CornerRadius="3" Padding="7,5" Margin="0,6,0,0"
                                            Visibility="{Binding IsToolCall, Converter={StaticResource BoolToVis}}">
                                        <TextBox Text="{Binding ToolArgumentsDisplay, Mode=OneWay}" IsReadOnly="True" IsTabStop="False"
                                                 TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0" Padding="0"
                                                 Background="Transparent" Foreground="{DynamicResource AppSubtext0}"
                                                 CaretBrush="{DynamicResource AppText}" FontFamily="Consolas, Courier New" FontSize="11"/>
                                    </Border>
                                    <StackPanel Margin="0,6,0,0" Visibility="{Binding IsApprovalPending, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Approval required" FontWeight="SemiBold" Foreground="{DynamicResource AppPeach}"/>
                                        <CheckBox Content="Automatically approve this tool for this session" IsChecked="{Binding AutoApproveForSession}" Margin="0,5,0,3" Foreground="{DynamicResource AppText}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:Button Content="Approve" Command="{Binding DataContext.ApproveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="10,3" Margin="0,0,6,0"/>
                                            <ui:Button Content="Reject" Command="{Binding DataContext.RejectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="10,3" Appearance="Secondary"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Background="{DynamicResource AppSurface1}" CornerRadius="3" Padding="7,5" Margin="0,6,0,0"
                                            Visibility="{Binding IsToolResult, Converter={StaticResource BoolToVis}}">
                                        <TextBox Text="{Binding ToolResultContent, Mode=OneWay}" IsReadOnly="True" IsTabStop="False"
                                                 TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0" Padding="0"
                                                 Background="Transparent" Foreground="{DynamicResource AppSubtext0}"
                                                 CaretBrush="{DynamicResource AppText}" FontFamily="Consolas, Courier New" FontSize="11"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Text="Enable AI and run Test Agent Compatibility in Settings to begin." TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AppSubtext0}">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CanUseAgent}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <Border Width="360" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="2"
                        Background="{DynamicResource AppSurface0}" BorderBrush="{DynamicResource AppSurface2}" BorderThickness="1" CornerRadius="6"
                        Visibility="{Binding IsToolsPanelVisible, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="Available tools" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AppText}" Margin="12,12,12,8"/>
                        <ScrollViewer Grid.Row="1" MaxHeight="480" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Tools}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource AppSurface1}" CornerRadius="4" Padding="8" Margin="12,0,18,6">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource AppText}"/>
                                                <TextBlock Text="{Binding Description}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource AppSubtext0}" Margin="0,3,0,0"/>
                                                <TextBlock Text="{Binding ParametersSchema}" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource AppOverlay1}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
                <Border Width="380" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="2"
                        Background="{DynamicResource AppSurface0}" BorderBrush="{DynamicResource AppSurface2}" BorderThickness="1" CornerRadius="6"
                        Visibility="{Binding IsHistoryPanelVisible, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="Chat history" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AppText}" Margin="12,12,12,8"/>
                        <ScrollViewer Grid.Row="1" MaxHeight="480" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Sessions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource AppSurface1}" CornerRadius="4" Padding="8" Margin="12,0,12,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <Button Content="{Binding DisplayLabel}" Command="{Binding DataContext.LoadSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                        HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AppText}" Padding="0"/>
                                                <ui:Button Grid.Column="1" Content="Delete" Command="{Binding DataContext.DeleteSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                           Padding="7,2" Appearance="Secondary" Margin="8,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{DynamicResource AppSubtext0}" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <ui:Button Content="Morning preparation" Command="{Binding RunMorningPreparationCommand}" Padding="9,3" Appearance="Secondary"/>
            </StackPanel>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="34" MaxHeight="282"
                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                         Padding="8,6" Background="{DynamicResource AppSurface1}" Foreground="{DynamicResource AppText}" BorderBrush="{DynamicResource AppSurface2}" KeyDown="OnInputKeyDown" ToolTip="Press Ctrl+Enter to send"/>
                <ui:Button Grid.Column="1" Content="Send" Command="{Binding SendCommand}" IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}" Margin="8,0,0,0" Padding="16,6"/>
                <ui:Button Grid.Column="2" Content="Stop" Command="{Binding CancelCommand}" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" Margin="8,0,0,0" Padding="16,6" Appearance="Secondary"/>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>